# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://klippa.co.za

# Internal cron auth — set a long random secret (e.g. openssl rand -hex 32)
# Must match the Authorization: Bearer <value> header sent by Vercel Cron
INTERNAL_CRON_SECRET=your-cron-secret

# Brevo — transactional email (https://brevo.com)
BREVO_API_KEY=your-brevo-api-key

# Ozow — SA payment gateway (https://ozow.com)
OZOW_SITE_CODE=your-ozow-site-code
OZOW_PRIVATE_KEY=your-ozow-private-key
OZOW_IS_TEST=true

# Sentry — error monitoring (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# OpenAI — SA tax chatbot (admin users only)
OPENAI_API_KEY=sk-xxx

# Mathpix — receipt/document OCR (https://mathpix.com)
MATHPIX_APP_ID=your-mathpix-app-id
MATHPIX_APP_KEY=your-mathpix-app-key
